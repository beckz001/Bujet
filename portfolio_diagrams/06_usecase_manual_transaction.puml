@startuml UseCase_ManualTransactionEntry
title Use Case — Manual Transaction Entry

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F6F6F6
  BorderColor #555555
}
skinparam ArrowColor #333333

actor User

rectangle "Manual transaction entry" {
  usecase "Manually add\ntransaction"            as Add
  usecase "Select date"                          as Date
  usecase "Enter description\n& merchant name"   as Desc
  usecase "Enter transaction\namount"            as Amount
  usecase "Categorise\ntransaction"              as Cat
  usecase "Save transaction"                     as Save
  usecase "Add another\ntransaction"             as Another

  User --> Add

  Add ..> Date    : <<include>>
  Add ..> Desc    : <<include>>
  Add ..> Amount  : <<include>>
  Add ..> Cat     : <<include>>
  Add ..> Save    : <<include>>
  Add <.. Another : <<extend>>
}

@enduml
