@startuml UseCase_TransactionImport
title Use Case — Transaction Import

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F6F6F6
  BorderColor #555555
}
skinparam ArrowColor #333333

actor User

rectangle "Transaction Import" {
  usecase "Import transactions"   as Import
  usecase "Obtain consent"        as Consent
  usecase "Retrieve transactions" as Retrieve

  User --> Import
  Import  ..> Consent  : <<include>>
  Consent ..> Retrieve : <<include>>
}

@enduml
